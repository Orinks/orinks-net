NEXT_PUBLIC_CONVEX_URL=""
# Production deploy key. In Vercel this is scoped to Preview (dev), so a push
# to dev deploys Convex functions to the PRODUCTION deployment: the site
# preview is a preview, the backend it deploys is not.
#
# A branch that changes the Convex schema must not reach production before it
# has been tested. Scope these to that branch's own Preview environment:
#   CONVEX_DEPLOY_KEY       a *preview* deploy key (Convex dashboard ->
#                           Project Settings -> Deploy Keys -> Generate
#                           Preview Deploy Key). It makes `npx convex deploy`
#                           create a fresh deployment named for the branch,
#                           and it cannot write to production.
#   CONVEX_URL              leave both UNSET for that branch. A preview deploy
#   NEXT_PUBLIC_CONVEX_URL  key sets them from the deployment it just created;
#                           pinning them by hand points the build back at a
#                           fixed deployment and defeats the isolation.
# Preview deployments exist on the Free plan and are deleted five days after
# creation. They start empty, so end-to-end testing provisions fresh records.
CONVEX_DEPLOY_KEY=""
# Clerk. Production uses the live instance (pk_live_/sk_live_); local work and
# preview branches use the development instance (pk_test_/sk_test_), which has
# test mode on by default -- any you+clerk_test@example.com address and any
# fictional phone number verify with the code 424242 and send nothing.
# Vercel has no branch-agnostic Preview value for CLERK_SECRET_KEY, so a new
# preview branch must set both of these for its own scope or server-side auth
# fails there.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
VISITOR_COUNTER_ENV=""
GITHUB_TOKEN=""
LASTFM_API_KEY=""
LASTFM_USERNAME=""
MASTODON_PROFILE_URL="https://mastodon.stickbear.me/@Orinks/"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@orinks.net"
BUILD_NOTIFICATION_TOKEN=""
# Contact form (/contact). Turnstile keys come from the Cloudflare dashboard;
# the site key is public by design and the secret key never leaves the server.
#
# For local development use Cloudflare's dummy keys instead of the real ones.
# They work from any hostname including localhost, so the production widget
# does not have to allow local domains (which Cloudflare advises against):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"  # always passes
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA" # always passes
# Swap the site key to 2x00000000000000000000AB to see the failure path.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Resend. CONTACT_FROM_EMAIL must sit on a domain verified in Resend, or the
# mail is treated as spoofed and filtered; the sender rides on Reply-To.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="orinks.net contact <contact@orinks.net>"
CONTACT_TO_EMAIL="orin8722@gmail.com"
