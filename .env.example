# Contact form (/contact). Turnstile keys come from the Cloudflare dashboard;
# the site key is public by design and the secret key never leaves the server.
#
# For local development use Cloudflare's dummy keys instead of the real ones.
# They work from any hostname including localhost, so the production widget
# does not have to allow local domains (which Cloudflare advises against):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"  # always passes
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA" # always passes
# Swap the site key to 2x00000000000000000000AB to see the failure path.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Resend. CONTACT_FROM_EMAIL must sit on a domain verified in Resend, or the
# mail is treated as spoofed and filtered; the sender rides on Reply-To.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="orinks.net contact <contact@orinks.net>"
CONTACT_TO_EMAIL="orin8722@gmail.com"
